    function handleSaveWorkMeta() {
      if (!activeEditTarget) return;
      const newName = editWorkNameInput ? editWorkNameInput.value.trim() : '';
      const newDesc = editWorkDescInput ? editWorkDescInput.value.trim() : '';

      if (!newName) {
