    // Sistem Scroll-Reveal
    const REVEAL_SELECTOR = [
      '.hero-copy',
      '.hero-visual',
      '.stat',
      '.section-head',
      '.section-head-row',
      '.visual-heading',
      '.card',
      '.skill-tile',
      '.app-chip',
      '.experience-banner',
