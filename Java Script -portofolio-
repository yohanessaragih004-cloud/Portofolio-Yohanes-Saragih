        removeBtn.addEventListener('click', () => {
          const current = loadSlotData();
          delete current[slotId];
          saveSlotData(current);
          sessionSlotVideoMap.delete(slotId);
          renderSlotCard(slotId);
          showToast('File dikembalikan ke slot kosong.');
