    let revealObserver = null;
    const supportsIntersectionObserver = 'IntersectionObserver' in window;
    const prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (supportsIntersectionObserver && !prefersReducedMotion) {
      revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, {
        root: null,
        threshold: 0.12,
        rootMargin: '0px 0px -36px 0px'
      });
    }

    function setupScrollRevealForPage(pageEl, resetAnimation = true) {
      if (!pageEl) return;
      const targets = [...pageEl.querySelectorAll(REVEAL_SELECTOR)];

      targets.forEach((el, index) => {
        if (!revealObserver) {
          el.classList.remove('reveal-item');
          el.classList.add('is-visible');
          return;
        }

        if (resetAnimation) {
          revealObserver.unobserve(el);
          el.classList.remove('is-visible');
          el.classList.add('reveal-item');
          const staggerDelay = (index % 6) * 65;
          el.style.setProperty('--reveal-delay', `${staggerDelay}ms`);
        } else if (!el.classList.contains('is-visible')) {
          el.classList.add('reveal-item');
        }
      });

      if (revealObserver) {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            targets.forEach(el => {
              if (!el.classList.contains('is-visible')) {
                revealObserver.observe(el);
              }
            });
          });
        });
      }
    }

    function showPage(name, updateHistory = true) {
      const target = document.getElementById(name);
      if (!target) return;

      pages.forEach(page => page.classList.toggle('active', page.id === name));
      document.querySelectorAll('.nav-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.go === name);
      });

      if (navLinks) navLinks.classList.remove('open');
      if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
      window.scrollTo({ top: 0, behavior: 'smooth' });

      setupScrollRevealForPage(target, true);

      if (updateHistory && location.hash !== '#' + name) {
        history.pushState({ page: name }, '', '#' + name);
      }
    }

