          <div>
            <div class="play" aria-hidden="true">＋</div>
            <strong style="font-size:${slotId === 'slot_video' ? '1.35rem' : '1.2rem'}; color:#fff">${escapeHtml((savedItem && savedItem.customTitle) ? savedItem.customTitle : meta.defaultTitle)}</strong>
            <p style="color:#bfdbfe; margin-top:4px">${meta.defaultSub}</p>
          </div>
        `;
        artEl.onclick = () => triggerSlotFilePicker(slotId);

        actionsEl.innerHTML = '';
        const uploadBtn = document.createElement('button');
        uploadBtn.type = 'button';
        uploadBtn.className = 'btn primary';
        uploadBtn.textContent = meta.btnText;
        uploadBtn.addEventListener('click', () => triggerSlotFilePicker(slotId));

        const editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'btn';
        editBtn.textContent = '✎ Edit Nama & Keterangan';
        editBtn.addEventListener('click', () => {
          openEditWorkModal(
            'slot',
            slotId,
            displayTitle,
            savedItem && savedItem.customDesc ? savedItem.customDesc : ''
          );
        });

        actionsEl.appendChild(uploadBtn);
        actionsEl.appendChild(editBtn);
      }
    }

    if (slotDirectFileInput) {
      slotDirectFileInput.addEventListener('change', async (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file || !activeTargetSlotId) return;

        const targetId = activeTargetSlotId;
        const cleanName = file.name.replace(/\.[^/.]+$/, '');
        const allSaved = loadSlotData();
        const prevSlot = allSaved[targetId] || {};
        const keepTitle = prevSlot.customTitle ? prevSlot.customTitle : cleanName;
        const keepDesc = typeof prevSlot.customDesc === 'string' ? prevSlot.customDesc : '';

        if (file.type.startsWith('image/')) {
          try {
            const compressedUrl = await compressImageToDataURL(file);
            allSaved[targetId] = {
              fileName: cleanName,
              customTitle: keepTitle,
              customDesc: keepDesc,
              mediaType: 'image',
              mediaUrl: compressedUrl
            };
            if (saveSlotData(allSaved)) {
              renderSlotCard(targetId);
              showToast('Gambar langsung ditampilkan di slot ini!');
            }
          } catch (err) {
            showToast('Gagal memproses gambar.');
          }
        } else if (file.type.startsWith('video/')) {
          const videoObjUrl = URL.createObjectURL(file);
          sessionSlotVideoMap.set(targetId, videoObjUrl);
          allSaved[targetId] = {
            fileName: cleanName,
            customTitle: keepTitle,
            customDesc: keepDesc,
            mediaType: 'video',
            mediaUrl: ''
          };
          saveSlotData(allSaved);
          renderSlotCard(targetId);
          showToast('Video langsung ditampilkan di slot ini!');
        } else {
          showToast('Pilih file berformat gambar atau video.');
        }
      });
    }

    Object.keys(defaultSlotsMeta).forEach(renderSlotCard);

    // =========================================================================
    // 2. FITUR TAMBAH KARTU BARU (TOMBOL "+ UPLOAD KARYA" DI ATAS)
    // =========================================================================
    const STORAGE_KEY = 'yohanes_dkv_uploaded_projects_v1';
    const uploadModal = document.getElementById('uploadModal');
    const openUploadModalBtn = document.getElementById('openUploadModalBtn');
    const closeUploadModalBtn = document.getElementById('closeUploadModalBtn');
    const cancelUploadBtn = document.getElementById('cancelUploadBtn');
    const uploadProjectForm = document.getElementById('uploadProjectForm');
    const saveProjectBtn = document.getElementById('saveProjectBtn');
    const uploadDropzone = document.getElementById('uploadDropzone');
    const projectFileInput = document.getElementById('projectFileInput');
    const dropzonePreview = document.getElementById('dropzonePreview');

    let currentUploadedMedia = { url: '', type: '', persistable: false };
    const sessionVideoMap = new Map();

    const categoryConfig = {
      poster: { label: 'Desain Poster', icon: '▧', theme: 'poster-theme', frame: 'CUSTOM / POSTER' },
      video: { label: 'Video / Cinematic', icon: '▶', theme: '', frame: 'CUSTOM / VIDEO' },
      photo: { label: 'Fotografi', icon: '◎', theme: 'photo-theme', frame: 'CUSTOM / PHOTO' },
      animation: { label: 'Animasi', icon: '◇', theme: 'poster-theme', frame: 'CUSTOM / ANIMATION' }
    };

    function loadCustomProjects() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function saveCustomProjects(list) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
        return true;
      } catch (e) {
        showToast('Penyimpanan penuh! Hapus beberapa karya lama atau gunakan gambar lebih kecil.');
        return false;
      }
    }

    async function handleSelectedFile(file) {
      if (!file || !dropzonePreview) return;
      dropzonePreview.innerHTML = '';

      if (file.type.startsWith('image/')) {
        try {
          const compressedDataUrl = await compressImageToDataURL(file);
          currentUploadedMedia = { url: compressedDataUrl, type: 'image', persistable: true };
          const img = document.createElement('img');
          img.src = compressedDataUrl;
          img.alt = 'Pratinjau gambar';
          dropzonePreview.appendChild(img);
          dropzonePreview.style.display = 'block';
        } catch (err) {
          showToast('Gagal memproses file gambar.');
        }
      } else if (file.type.startsWith('video/')) {
        const objectUrl = URL.createObjectURL(file);
        currentUploadedMedia = { url: objectUrl, type: 'video', persistable: false, file };
        const vid = document.createElement('video');
        vid.src = objectUrl;
        vid.controls = true;
        vid.muted = true;
        dropzonePreview.appendChild(vid);
        dropzonePreview.style.display = 'block';
      } else {
        showToast('Format file harus berupa gambar atau video.');
      }
    }

    function resetUploadForm() {
      if (uploadProjectForm) uploadProjectForm.reset();
      currentUploadedMedia = { url: '', type: '', persistable: false };
      if (dropzonePreview) {
        dropzonePreview.innerHTML = '';
        dropzonePreview.style.display = 'none';
      }
    }

    function openUploadModal() {
      if (!uploadModal) return;
      resetUploadForm();
      uploadModal.classList.add('open');
    }

    function closeUploadModal() {
      if (!uploadModal) return;
      uploadModal.classList.remove('open');
    }

    function createProjectCardElement(item) {
      const cfg = categoryConfig[item.category] || categoryConfig.poster;
      const activeMediaUrl = item.mediaType === 'video'
        ? (sessionVideoMap.get(item.id) || '')
        : (item.mediaUrl || '');

      const article = document.createElement('article');
      article.className = 'card project custom-project-card';
      article.dataset.category = item.category;
      article.dataset.id = item.id;

      const artDiv = document.createElement('div');
      artDiv.className = `project-art ${cfg.theme} ${activeMediaUrl ? 'has-media' : ''}`;

      if (activeMediaUrl && item.mediaType === 'image') {
        const coverImg = document.createElement('img');
        coverImg.src = activeMediaUrl;
        coverImg.alt = item.title;
        coverImg.className = 'project-media-cover';
        artDiv.appendChild(coverImg);
      } else if (activeMediaUrl && item.mediaType === 'video') {
        const coverVid = document.createElement('video');
        coverVid.src = activeMediaUrl;
        coverVid.muted = true;
        coverVid.loop = true;
        coverVid.playsInline = true;
        coverVid.className = 'project-media-cover';
        artDiv.appendChild(coverVid);
      }

      const frameSpan = document.createElement('span');
      frameSpan.className = 'frame-tag';
      frameSpan.textContent = cfg.frame;
      artDiv.appendChild(frameSpan);

      const centerBox = document.createElement('div');
      centerBox.innerHTML = `
        <div class="play" aria-hidden="true">${cfg.icon}</div>
        <strong style="font-size:1.2rem; color:#fff; text-shadow:0 2px 10px rgba(0,0,0,.75);">${escapeHtml(item.title)}</strong>
        <p style="color:#bfdbfe; margin-top:4px; text-shadow:0 2px 8px rgba(0,0,0,.75);">${cfg.label}</p>
      `;
      artDiv.appendChild(centerBox);

      const finalDesc = item.desc || 'Karya portofolio yang ditambahkan oleh Yohanes Saragih.';

      const openPreviewHandler = () => {
        window.openLightbox(
          item.title,
          `${cfg.label} · Karya Upload`,
          finalDesc,
          cfg.icon,
          item.link || '',
          activeMediaUrl,
          activeMediaUrl ? item.mediaType : ''
        );
      };

      artDiv.addEventListener('click', openPreviewHandler);

      const contentDiv = document.createElement('div');
      contentDiv.className = 'project-content';

      const infoDiv = document.createElement('div');
      infoDiv.innerHTML = `
        <h3>${escapeHtml(item.title)}</h3>
        <p class="project-desc-text">${escapeHtml(item.desc || 'Karya kreatif yang diunggah ke portofolio.')}</p>
        <div class="project-meta">
          <span>${cfg.label}</span>
          <span>Karya Upload</span>
        </div>
      `;

      const actionsDiv = document.createElement('div');
      actionsDiv.className = 'project-actions';

      const previewBtn = document.createElement('button');
      previewBtn.type = 'button';
      previewBtn.className = 'btn primary';
      previewBtn.textContent = 'Lihat Pratinjau';
      previewBtn.addEventListener('click', openPreviewHandler);
      actionsDiv.appendChild(previewBtn);

      const editBtn = document.createElement('button');
      editBtn.type = 'button';
      editBtn.className = 'btn';
      editBtn.textContent = '✎ Edit Nama & Keterangan';
      editBtn.addEventListener('click', () => {
        openEditWorkModal('custom', item.id, item.title, item.desc || '');
      });
      actionsDiv.appendChild(editBtn);

      const deleteBtn = document.createElement('button');
      deleteBtn.type = 'button';
      deleteBtn.className = 'btn-danger-sm';
      deleteBtn.textContent = 'Hapus';
      deleteBtn.addEventListener('click', () => {
        const updated = loadCustomProjects().filter(p => p.id !== item.id);
        saveCustomProjects(updated);
        sessionVideoMap.delete(item.id);
        article.remove();
        showToast('Karya berhasil dihapus.');
      });
      actionsDiv.appendChild(deleteBtn);

      contentDiv.appendChild(infoDiv);
      contentDiv.appendChild(actionsDiv);
      article.appendChild(artDiv);
      article.appendChild(contentDiv);

      return article;
    }

    function renderAllCustomProjects() {
      if (!projectsGrid) return;
      document.querySelectorAll('.custom-project-card').forEach(el => el.remove());
      const items = loadCustomProjects();
      items.forEach(item => {
        const cardEl = createProjectCardElement(item);
        projectsGrid.appendChild(cardEl);
      });
      applyProjectFilter();
      const projectsPage = document.getElementById('projects');
      if (projectsPage && projectsPage.classList.contains('active')) {
        setupScrollRevealForPage(projectsPage, false);
      }
    }

    if (openUploadModalBtn) openUploadModalBtn.addEventListener('click', openUploadModal);
    if (closeUploadModalBtn) closeUploadModalBtn.addEventListener('click', closeUploadModal);
    if (cancelUploadBtn) cancelUploadBtn.addEventListener('click', closeUploadModal);
    if (uploadModal) {
      uploadModal.addEventListener('click', (e) => {
        if (e.target === uploadModal) closeUploadModal();
      });
    }

    if (uploadDropzone && projectFileInput) {
      uploadDropzone.addEventListener('click', () => projectFileInput.click());
      projectFileInput.addEventListener('change', (e) => {
        if (e.target.files && e.target.files[0]) {
          handleSelectedFile(e.target.files[0]);
        }
      });

      uploadDropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
        uploadDropzone.classList.add('dragover');
      });
      uploadDropzone.addEventListener('dragleave', () => {
        uploadDropzone.classList.remove('dragover');
      });
      uploadDropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        uploadDropzone.classList.remove('dragover');
        if (e.dataTransfer.files && e.dataTransfer.files[0]) {
          handleSelectedFile(e.dataTransfer.files[0]);
        }
      });
    }

    function saveUploadedProject() {
      const titleEl = document.getElementById('projectTitleInput');
      const titleVal = titleEl ? titleEl.value.trim() : '';
      if (!titleVal) {
        showToast('Nama / judul karya wajib diisi.');
        if (titleEl) titleEl.focus();
        return;
      }

      const categoryVal = document.getElementById('projectCategoryInput').value;
      const descVal = document.getElementById('projectDescInput').value.trim();
      const linkVal = document.getElementById('projectLinkInput').value.trim();
      const newId = 'proj_' + Date.now();
      if (currentUploadedMedia.type === 'video' && currentUploadedMedia.url) {
        sessionVideoMap.set(newId, currentUploadedMedia.url);
      }
      const newProject = {
        id: newId,
        title: titleVal,
        category: categoryVal,
        desc: descVal,
        link: linkVal,
        mediaType: currentUploadedMedia.type || '',
        mediaUrl: currentUploadedMedia.persistable ? currentUploadedMedia.url : ''
      };
      const existing = loadCustomProjects();
      existing.unshift(newProject);
      if (saveCustomProjects(existing)) {
        renderAllCustomProjects();
        closeUploadModal();
        showToast('Karya baru berhasil ditambahkan!');
      }
    }

    if (uploadProjectForm) {
      uploadProjectForm.addEventListener('submit', (e) => {
        e.preventDefault();
        saveUploadedProject();
      });
    }
    if (saveProjectBtn) {
      saveProjectBtn.type = 'button';
      saveProjectBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        saveUploadedProject();
      });
    }

    renderAllCustomProjects();

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (lightboxModal && lightboxModal.classList.contains('open')) closeLightbox();
        if (toolModal && toolModal.classList.contains('open')) closeToolModal();
        if (uploadModal && uploadModal.classList.contains('open')) closeUploadModal();
        if (editMetaModal && editMetaModal.classList.contains('open')) closeEditWorkModal();
      }
    });

    const yearEl = document.getElementById('year');
    if (yearEl) yearEl.textContent = new Date().getFullYear();
    const initial = location.hash.slice(1);
    showPage(document.getElementById(initial) ? initial : 'home', false);
  } catch (err) {
    console.error('Terjadi kesalahan pada inisialisasi skrip:', err);
  }
});
